[Unit]
Description=Exchange Rate Sync Service
After=network.target

[Service]
Type=simple
User=prd-n8n
WorkingDirectory=/opt/exchange-rate-sync
Environment=SERVICE_HOST=0.0.0.0
Environment=SERVICE_PORT=8770
ExecStart=/usr/bin/python3 /opt/exchange-rate-sync/service/exchange_rate_service.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
