# Dependencies
node_modules/

# n8n
.n8n/

# Credentials (never commit)
credentials.json
*.credentials.json
workflows/*/certificate/

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build output
dist/
build/

# Test coverage
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Local git worktrees
.worktrees/
.claude/

# Local brainstorming/mockup artifacts
.superpowers/

# Python cache
__pycache__/
*.pyc

# Backup files
*.backup
*.bak

# Sample PDFs (large files)
workflows/*/tests/samples/*.pdf
workflows/*/pdf-examples/**/*.pdf

# Local customer data and Profile Lab run artifacts
workflows/*/profile-lab/customers/

# Compressed files
*.zip
*.tar.gz
*.rar
